# ===========================================
# Supabase (shared)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
# Legacy HS256 secret. Required as fallback for projects on the legacy JWT secret.
# New Supabase projects (post-2024-Q4) sign with asymmetric keys (RS256/ES256) —
# set SUPABASE_JWKS_URL below and the backend will verify via JWKS automatically.
SUPABASE_JWT_SECRET=your-jwt-secret
# Asymmetric JWT verification (recommended for new projects).
# Leave empty to keep HS256-only verification.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# JWKS_TTL_SECS=3600

# ---- DATABASE_URL guidance ----
# Persistent backend (Railway / VM / Docker) → use DIRECT connection (port 5432).
# Direct keeps prepared statements (sqlx macros depend on them).
# Supavisor transaction mode (6543) does NOT support prepared statements;
# the backend will auto-disable the statement cache if it detects 6543 / pgbouncer=true,
# but performance and correctness are best on the direct port.
#
# IPv4-only host? Use Supavisor SESSION mode (port 5432 on the pooler, NOT 6543).
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Used by `sqlx migrate run` (must be the direct connection — migrations need DDL).
DATABASE_URL_DIRECT=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ===========================================
# Backend (Railway)
# ===========================================
# Railway injects PORT automatically; for local dev use BACKEND_PORT
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000
RUST_LOG=backend=debug,tower_http=debug

# Optional tuning (defaults shown)
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=2
# REQUEST_TIMEOUT_SECS=30
# BODY_LIMIT_BYTES=2097152
# ITEMS_PAGE_SIZE=50
# RATE_LIMIT_PER_SEC=10
# RATE_LIMIT_BURST=20

# OpenTelemetry — only honoured when built with `cargo build --features otel`.
# Set to a collector endpoint (Honeycomb, Tempo, Jaeger, OTel Collector...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Shared secret for HMAC-SHA256 verification on POST /webhooks/{provider}.
# Leave unset to disable the receiver entirely (returns 400).
# WEBHOOK_SECRET=change-me-32-bytes-of-entropy

# ===========================================
# Frontend (Vercel)
# ===========================================
# NEXT_PUBLIC_ vars are exposed to the browser — only put safe values here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never prefix with NEXT_PUBLIC_
API_URL=http://localhost:8080
