# ===========================================
# Supabase (shared)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Database — pooled connection (port 6543, PgBouncer)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.co:6543/postgres?pgbouncer=true
# Database — direct connection (port 5432, for migrations only)
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ===========================================
# Backend (Railway)
# ===========================================
# Railway injects PORT automatically; for local dev use BACKEND_PORT
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000
RUST_LOG=backend=debug,tower_http=debug

# Optional tuning (defaults shown)
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=2
# REQUEST_TIMEOUT_SECS=30
# BODY_LIMIT_BYTES=2097152
# ITEMS_PAGE_SIZE=50
# CACHE_TTL_SECS=300
# CACHE_MAX_CAPACITY=10000

# ===========================================
# Frontend (Vercel)
# ===========================================
# NEXT_PUBLIC_ vars are exposed to the browser — only put safe values here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never prefix with NEXT_PUBLIC_
API_URL=http://localhost:8080
